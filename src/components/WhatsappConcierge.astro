---
---

<div id="concierge-section" class="hidden rounded-2xl border border-luxury-gold/50 bg-white/90 p-6 sm:p-8 shadow-xl transition-colors dark:border-luxury-gold/50 dark:bg-gradient-to-b dark:from-luxury-darkSurface dark:to-luxury-darkCard">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-luxury-lightBorder pb-5 dark:border-luxury-darkBorder/60">
    <div>
      <div class="flex items-center gap-2">
        <span class="rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-700 border border-emerald-500/30 dark:bg-emerald-500/20 dark:text-emerald-300">
          Booking Confirmed ✓
        </span>
        <span class="text-xs font-mono text-slate-400 dark:text-luxury-muted" id="concierge-booking-id">ID: AUR-819230</span>
      </div>
      <h3 class="mt-2 font-serif text-2xl font-normal text-slate-900 dark:text-white">
        Automated WhatsApp Guest Concierge
      </h3>
      <p class="text-xs font-light text-slate-500 dark:text-slate-300 mt-1">
        Pesan sambutan VIP berisikan petunjuk kedatangan, titik peta GPS, dan kode sandi pintu villa otomatis dibuat.
      </p>
    </div>

    <!-- Direct WA Trigger -->
    <a
      id="btn-send-wa"
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-semibold text-white shadow-sm transition hover:bg-emerald-500 active:scale-95 whitespace-nowrap"
    >
      <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.149.929 3.182 0 5.767-2.587 5.768-5.766 0-3.18-2.586-5.771-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.942-.708-1.797 0-.855.449-1.277.608-1.448.16-.171.348-.214.464-.214.116 0 .232.001.333.006.107.005.25-.041.391.298.145.348.493 1.203.536 1.29.043.087.072.189.014.305-.058.116-.087.188-.174.29-.087.102-.183.228-.261.306-.087.087-.178.182-.077.355.101.174.45 1.05 1.29 1.448.145.069.261.087.362.087.217 0 .435-.116.522-.261.116-.188.464-.783.58-.957.116-.174.232-.145.391-.087.16.058 1.015.479 1.189.566.174.087.29.13.333.203.044.072.044.42-.1 1.025z"/>
      </svg>
      <span>Buka di WhatsApp (Kirim Tamu)</span>
    </a>
  </div>

  <!-- WhatsApp Chat Bubble Simulation -->
  <div class="mt-6 max-w-2xl rounded-2xl border border-emerald-500/20 bg-[#111b21] p-5 shadow-inner text-slate-100">
    <div class="flex items-center gap-3 border-b border-slate-800 pb-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-700 text-white font-serif font-bold text-xs">
        VS
      </div>
      <div>
        <p class="text-xs font-medium text-white">The Maya Sanctuary Concierge</p>
        <p class="text-[10px] text-emerald-400">Veridion Automated Dispatch • Online</p>
      </div>
    </div>

    <!-- Message Content -->
    <div class="mt-4 rounded-xl bg-[#202c33] p-4 text-xs font-mono text-slate-100 whitespace-pre-wrap leading-relaxed border-l-4 border-emerald-500 shadow" id="wa-message-preview">
      Memuat template reservasi...
    </div>

    <div class="mt-3 flex items-center justify-between text-[11px] text-slate-400">
      <span>Disinkronkan otomatis setelah pembayaran QRIS diverifikasi.</span>
      <button
        type="button"
        id="btn-copy-wa"
        class="rounded bg-slate-800 px-3 py-1 text-slate-200 hover:bg-slate-700 transition"
      >
        Salin Pesan
      </button>
    </div>
  </div>
</div>

<script>
  const conciergeSection = document.getElementById('concierge-section');
  const conciergeBookingId = document.getElementById('concierge-booking-id');
  const waPreview = document.getElementById('wa-message-preview');
  const btnSendWa = document.getElementById('btn-send-wa') as HTMLAnchorElement;
  const btnCopyWa = document.getElementById('btn-copy-wa');

  window.addEventListener('booking-confirmed', (e: any) => {
    const data = e.detail;
    if (!conciergeSection) return;

    conciergeSection.classList.remove('hidden');
    if (conciergeBookingId) conciergeBookingId.textContent = `ID: ${data.code}`;

    const textTemplate = 
`✨ *KONFIRMASI RESERVASI LUXURY VILLA — THE MAYA SANCTUARY ULUWATU* ✨

Yth. Tamu Terhormat,
Terima kasih telah melakukan pemesanan langsung melalui *Aura Direct Booking Engine*. Pemesanan Anda telah terverifikasi dengan aman di sistem kami:

📋 *DETAIL RESERVASI*
• Kode Booking: *${data.code}*
• Periode: *${data.checkIn} s/d ${data.checkOut}* (${data.nights} Malam)
• Tamu: *${data.guests} Orang*
• Status Pembayaran: *${data.paymentType} Terverifikasi (Rp ${Number(data.amountPaid).toLocaleString('id-ID')})*

📍 *LOKASI & PANDUAN KEDATANGAN*
• Google Maps: https://maps.google.com/?q=-8.8472,115.1147
• Alamat: Jl. Pantai Suluban, Pecatu, Uluwatu, Bali
• Smart Door Code: *#${data.code.replace('AUR-', '')}#* (Aktif saat jam Check-in 14:00 WITA)
• High-Speed Starlink Wi-Fi: "MayaSanctuary_VIP" (Pass: *UluwatuSunset2026*)

Butler pribadi Anda (Wayan) siap menyambut Anda setibanya di villa. Jika ada preferensi dietary khusus untuk complimentary Floating Breakfast, silakan balas pesan ini.

_Crafted by Veridion Studio — Dedicated Hospitality Tech Studio_`;

    if (waPreview) waPreview.textContent = textTemplate;

    if (btnSendWa) {
      const encoded = encodeURIComponent(textTemplate);
      btnSendWa.href = `https://wa.me/6282322370126?text=${encoded}`;
    }

    conciergeSection.scrollIntoView({ behavior: 'smooth' });
  });

  btnCopyWa?.addEventListener('click', () => {
    if (waPreview && waPreview.textContent) {
      navigator.clipboard.writeText(waPreview.textContent).then(() => {
        if (btnCopyWa) btnCopyWa.textContent = 'Tersalin! ✓';
        setTimeout(() => {
          if (btnCopyWa) btnCopyWa.textContent = 'Salin Pesan';
        }, 2000);
      });
    }
  });
</script>
