---
import { VILLA_DATA } from '../data/villaData';
---

<section class="relative pt-6 pb-10 sm:pb-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header Titles: Minimalist Editorial Style -->
    <div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div class="space-y-2">
        <div class="flex items-center gap-2.5 text-xs font-semibold tracking-widestLuxury uppercase text-luxury-gold">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-luxury-gold"></span>
          <span>Private Sanctuary</span>
          <span class="text-slate-400 dark:text-luxury-muted">&bull;</span>
          <span class="text-slate-600 dark:text-luxury-muted">{VILLA_DATA.location}</span>
        </div>
        <h1 class="font-serif text-3xl font-medium tracking-tight text-slate-900 transition-colors dark:text-white sm:text-4xl lg:text-5xl">
          {VILLA_DATA.name}
        </h1>
        <p class="text-sm font-light text-slate-600 dark:text-slate-300 sm:text-base max-w-2xl leading-relaxed">
          {VILLA_DATA.tagline}
        </p>
      </div>

      <!-- Quick Metrics Badges: Minimalist Line Outline -->
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <div class="rounded-lg border border-luxury-lightBorder bg-white/70 px-3 py-1.5 text-slate-700 shadow-sm backdrop-blur transition-colors dark:border-luxury-darkBorder dark:bg-luxury-darkCard/80 dark:text-slate-300">
          <strong class="font-semibold text-slate-900 dark:text-white">{VILLA_DATA.capacity.bedrooms}</strong> Suites
        </div>
        <div class="rounded-lg border border-luxury-lightBorder bg-white/70 px-3 py-1.5 text-slate-700 shadow-sm backdrop-blur transition-colors dark:border-luxury-darkBorder dark:bg-luxury-darkCard/80 dark:text-slate-300">
          <strong class="font-semibold text-slate-900 dark:text-white">{VILLA_DATA.capacity.guests}</strong> Guests
        </div>
        <div class="rounded-lg border border-luxury-lightBorder bg-white/70 px-3 py-1.5 text-slate-700 shadow-sm backdrop-blur transition-colors dark:border-luxury-darkBorder dark:bg-luxury-darkCard/80 dark:text-slate-300">
          <strong class="font-semibold text-slate-900 dark:text-white">{VILLA_DATA.capacity.bathrooms}</strong> Baths
        </div>
        <div class="rounded-lg border border-luxury-lightBorder bg-white/70 px-3 py-1.5 text-slate-700 shadow-sm backdrop-blur transition-colors dark:border-luxury-darkBorder dark:bg-luxury-darkCard/80 dark:text-slate-300">
          <strong class="font-semibold text-slate-900 dark:text-white">{VILLA_DATA.capacity.sqm}</strong> m² Estate
        </div>
      </div>
    </div>

    <!-- Editorial Image Grid with Subtle Rounded Corners & Hover Glow -->
    <div class="grid grid-cols-1 gap-3 md:grid-cols-4 md:grid-rows-2 md:h-[500px]">
      <!-- Main Featured Image -->
      <div class="group relative overflow-hidden rounded-2xl md:col-span-2 md:row-span-2 shadow-sm border border-luxury-lightBorder dark:border-luxury-darkBorder/60">
        <img
          src={VILLA_DATA.gallery[0].url}
          alt={VILLA_DATA.gallery[0].caption}
          class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
        <div class="absolute bottom-4 left-5 right-5 flex items-end justify-between">
          <div>
            <span class="inline-block rounded-full bg-white/20 px-3 py-0.5 text-[10px] font-semibold tracking-wider text-white backdrop-blur-md">
              Ocean Cliff Panorama
            </span>
            <p class="mt-1 font-serif text-base font-medium text-white drop-shadow-sm">
              {VILLA_DATA.gallery[0].caption}
            </p>
          </div>
        </div>
      </div>

      <!-- 4 Supplementary Editorial Images -->
      {VILLA_DATA.gallery.slice(1, 5).map((img) => (
        <div class="group relative h-48 md:h-full overflow-hidden rounded-2xl shadow-sm border border-luxury-lightBorder dark:border-luxury-darkBorder/60">
          <img
            src={img.url}
            alt={img.caption}
            class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
          <div class="absolute bottom-3 left-3 right-3 text-xs font-medium text-white drop-shadow-sm opacity-0 group-hover:opacity-100 transition-opacity">
            {img.caption}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
