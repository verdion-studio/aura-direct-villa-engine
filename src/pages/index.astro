---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroGallery from '../components/HeroGallery.astro';
import VillaSpecs from '../components/VillaSpecs.astro';
import BookingEngine from '../components/BookingEngine.astro';
import IcalInspector from '../components/IcalInspector.astro';
import WhatsappConcierge from '../components/WhatsappConcierge.astro';
import FooterWatermark from '../components/FooterWatermark.astro';
---

<Layout>
  <Navbar />

  <main class="space-y-12">
    <!-- Hero & Visual Gallery -->
    <HeroGallery />

    <!-- Core Interactive Booking Container -->
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 items-start">
        <!-- Left: Specifications, Story & Amenities (7 cols) -->
        <div class="lg:col-span-7 space-y-12">
          <VillaSpecs />
          
          <!-- Automated Concierge Area (Populates after payment) -->
          <WhatsappConcierge />
        </div>

        <!-- Right: Direct Booking Engine & Pricing Widget (5 cols) -->
        <div class="lg:col-span-5">
          <BookingEngine />
        </div>
      </div>
    </div>

    <!-- 2-Way iCal Sync Inspector (Anti-Overbooking Section) -->
    <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-6">
      <IcalInspector />
    </section>
  </main>

  <FooterWatermark />
</Layout>
