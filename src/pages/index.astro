---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroGallery from '../components/HeroGallery.astro';
import VillaSpecs from '../components/VillaSpecs.astro';
import BookingEngine from '../components/BookingEngine.astro';
import IcalInspector from '../components/IcalInspector.astro';
import WhatsappConcierge from '../components/WhatsappConcierge.astro';
import FooterWatermark from '../components/FooterWatermark.astro';
---

<Layout>
  <Navbar />

  <main class="space-y-8 sm:space-y-12 pb-24 lg:pb-0">
    <!-- Hero & Visual Gallery -->
    <HeroGallery />

    <!-- Core Interactive Booking Container -->
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Mobile-First Order: Di mobile layar kecil, pengguna bisa melihat booking widget atau overview dengan seamless ordering -->
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10 items-start">
        
        <!-- Booking Engine & Pricing Widget (Di mobile diletakkan dengan prioritas tinggi atau sticky, di desktop 5 cols kanan) -->
        <div class="order-1 lg:order-2 lg:col-span-5" id="booking-container">
          <BookingEngine />
        </div>

        <!-- Left: Specifications, Story & Amenities (Di desktop 7 cols kiri) -->
        <div class="order-2 lg:order-1 lg:col-span-7 space-y-8 sm:space-y-12">
          <VillaSpecs />
          
          <!-- Automated Concierge Area (Populates after payment) -->
          <WhatsappConcierge />
        </div>
      </div>
    </div>

    <!-- 2-Way iCal Sync Inspector (Anti-Overbooking Section) -->
    <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6">
      <IcalInspector />
    </section>
  </main>

  <!-- Sticky Bottom Bar Khusus Mobile (< 1024px) -->
  <div class="fixed bottom-0 left-0 right-0 z-40 border-t border-luxury-lightBorder bg-white/95 px-4 py-3 backdrop-blur-md shadow-lg transition-colors dark:border-luxury-darkBorder dark:bg-luxury-darkSurface/95 lg:hidden">
    <div class="mx-auto flex max-w-md items-center justify-between gap-3">
      <div>
        <p class="text-[10px] uppercase tracking-wider text-slate-500 dark:text-luxury-muted font-medium">Mulai dari</p>
        <div class="flex items-baseline gap-1">
          <span class="font-serif text-lg font-bold text-luxury-gold">Rp 6.500.000</span>
          <span class="text-[10px] text-slate-400">/malam</span>
        </div>
      </div>
      <a
        href="#booking-widget"
        class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-luxury-gold to-amber-600 px-5 py-2.5 text-xs font-semibold tracking-wider text-white uppercase shadow-md active:scale-95 dark:text-luxury-dark dark:font-bold"
      >
        Pesan Sekarang
      </a>
    </div>
  </div>

  <FooterWatermark />
</Layout>
